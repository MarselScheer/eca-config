{
    "defaultModel" : "deepseek/deepseek-flash",
    "defaultAgent" : "code",
    "agent": {
	"code": {
	    "defaultModel" : "deepseek/deepseek-flash"
	}
    },
    "providers" : {
	"deepseek" : {
	    "api" : "openai-chat",
	    "url" : "https://api.deepseek.com",
	    "key" : "${env:DEEPSEEK_API_KEY}",
	    "models" : {
		"deepseek-v4-pro": { },
		"deepseek-flash": { }
	    }
	},
	"openrouter" : {
	    "api" : "openai-chat",
	    "url" : "https://openrouter.ai/api/v1",
	    "key" : "${env:OPENROUTER_API_KEY}",
	    "models" : {
		"deepseek/deepseek-v4-pro": { },
		"deepseek/deepseek-v4-flash": { }
	    }
	},
	"ollama" : {
	    "api" : "openai-chat",
	    "url" : "${env:OLLAMA_HOST}",
	    "models" : {
		"gemma4:cloud256ctx" : { }
	    }
	}
    },
    "toolCall": {
	"approval": {
	    "byDefault": "ask",
	    "allow": {
		"shell_command": {"argsMatchers": {"command": ["make test"]}}
	    }
	}
    },
    "mcpServers": {
	"python-repl": {
	    "command": "uv",
	    "args": [
		"--directory",
		"/home/m/docker_fs/repos/mcp-sandbox-pyrepl",
		"run",
		"src/main.py"
	    ]
	},
	"context7": {
	    "url": "https://mcp.context7.com/mcp",
	    "headers": {
		"CONTEXT7_API_KEY": "${env:CONTEXT7_API_KEY}"
	    }
	}
    },
    "customTools": {
	"web-search": {
	    "description": "Fetches the content of a URL and returns it in Markdown format.",
	    "command": "trafilatura --output-format=markdown -u {{url}}",
	    "schema": {
		"properties": {
		    "url": {
			"type": "string",
			"description": "The URL to fetch content from."
		    }
		},
		"required": ["url"]
	    }
	},
	"file-search": {
	    "description": "${file:tools/my-tool.md}",
	    "command": "find {{directory}} -name {{pattern}}",
	    "schema": {
		"properties": {
		    "directory": {
			"type": "string",
			"description": "The directory to start the search from."
		    },
		    "pattern": {
			"type": "string",
			"description": "The search pattern for the filename (e.g., '*.clj')."
		    }
		},
		"required": ["directory", "pattern"]
	    }
	}
    }
}
